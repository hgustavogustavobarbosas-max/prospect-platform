      "id": "f303ba35-ce8c-5711-b7ed-7c45acbfc79a",
      "name": "Propostas aceitas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Normaliza a resposta da API (lista) em um item por registro, com ou sem split automatico do n8n\nconst out = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  if (Array.isArray(j)) j.forEach(r => out.push({ json: r })); else if (j && j.id) out.push({ json: j });\n}\nreturn out;"
      },
      "id": "c4196fb5-13c4-5ae0-bfc7-5387383d209d",
      "name": "Lista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PROSPECT_API_URL }}/v1/opportunities/{{ $json.id }}/kickoff",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.PROSPECT_API_KEY }}"
            }
          ]
        }
