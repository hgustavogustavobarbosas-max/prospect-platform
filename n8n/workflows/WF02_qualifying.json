      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: {\n  topic: 'notify_human',\n  payload: { kind: 'lead_a', lead_id: i.json.id, text: `Novo lead A (${i.json.score}/100): ${i.json.justification}` },\n  idempotency_key: `lead-qualified-${i.json.id}`,\n}}));"
      },
