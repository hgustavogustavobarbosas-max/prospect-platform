    {
      "parameters": {
        "jsCode": "// Normaliza a resposta da API (lista) em um item por registro, com ou sem split automatico do n8n\nconst out = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  if (Array.isArray(j)) j.forEach(r => out.push({ json: r })); else if (j && j.lead_id) out.push({ json: j });\n}\nreturn out;"
      },
      "id": "3bbd5d77-02f5-5c0e-8e3c-4852088f42c1",
      "name": "Lista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: {\n  topic: 'send_whatsapp_template',\n  payload: { lead_id: i.json.lead_id, template: i.json.template, attempt: i.json.attempt },\n  idempotency_key: i.json.idempotency_key,\n}}));"
      },
