# Copie para .env e TROQUE todos os valores marcados. Nunca versione o .env.
# Gere segredos com: openssl rand -hex 32

# --- Postgres ---
POSTGRES_USER=prospect
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=prospect

# --- API ---
APP_ENV=development            # development | production
JWT_SECRET=troque-por-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60
# Chave usada pelo n8n (header X-API-Key) para chamar a API
SERVICE_API_KEY=troque-por-openssl-rand-hex-32
# Admin criado automaticamente no primeiro start (se nao existir)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha-admin
LOG_LEVEL=INFO
LOG_JSON=true

# --- n8n ---
N8N_VERSION=latest             # fixe uma versao em producao (ex.: 1.x.y)
N8N_ENCRYPTION_KEY=troque-por-openssl-rand-hex-32
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=America/Sao_Paulo

# --- Prospeccao (Parte 2) ---
GOOGLE_PLACES_API_KEY=
PLACES_DAILY_CALL_LIMIT=50          # teto duro de chamadas/dia (o Google nao tem teto de gasto)
PLACES_COST_MICRO_USD_PER_CALL=0    # opcional: preco do seu SKU (1e-6 USD) p/ acompanhar custo
PLACES_STORAGE_MODE=strict          # strict (so place_id + analise propria) | permissive (leia docs/adr/0004)
PLACES_CACHE_TTL_DAYS=30            # so no modo permissive
SITE_CHECK_ENABLED=true
SITE_CHECK_TIMEOUT=5
PILOT_SEGMENTS=barbearia,estetica   # separados por virgula
TIER_A_MIN=70
TIER_B_MIN=40

# --- IA opcional no scoring ---
LLM_ENABLED=false
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MODEL=claude-haiku-5-5
LLM_DAILY_TOKEN_LIMIT=200000
LLM_DAILY_CALL_LIMIT=250
LLM_RPM_LIMIT=10
LLM_INPUT_TPM_LIMIT=2500
LLM_MIN_BASE_SCORE=30

# --- n8n: workflows e avisos (Parte 3) ---
N8N_WEBHOOK_SECRET=troque-por-openssl-rand-hex-32   # header x-webhook-secret exigido pelo WF04
# URL de um "incoming webhook" (Slack, Discord, Teams...) para os avisos humanos. O WF05 precisa dela.
NOTIFY_WEBHOOK_URL=

# --- Agente comercial (Parte 3) ---
AGENT_ENABLED=true
AGENT_MODEL=claude-haiku-5-5
AGENT_MAX_TURNS=20
AGENT_MAX_TOKENS_PER_CONVERSATION=30000
AGENT_HISTORY_MESSAGES=12
AGENCY_NAME=nossa agencia           # aparece na apresentacao "assistente virtual da ..."
ALLOWED_REPLY_HOSTS=                # dominios que o agente pode citar (ex.: minhaagencia.com.br)
FOLLOWUP_AFTER_HOURS=48
MAX_FOLLOWUPS=2
LLM_COST_MICRO_USD_PER_1K_TOKENS=0

# --- Parte 4: WhatsApp, links publicos, seguranca ---
PUBLIC_BASE_URL=http://localhost:3000     # URL publica (links de proposta/briefing/previa). Em producao: https://seu-dominio
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=                    # token permanente (usuario do sistema) da WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                      # "Chave secreta do app" (valida X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=troque-por-openssl-rand-hex-16
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_MAX_TEMPLATES_PER_DAY=50         # respeite o tier atual do seu numero
HUMAN_SLA_MINUTES=30
PROPOSAL_VALIDITY_DAYS=7
PREVIEW_TTL_DAYS=14
PAYMENT_WEBHOOK_SECRET=                   # HMAC dos webhooks de pagamento (quando houver provedor)
# Chaves Fernet (a 1a cifra, as demais so decifram: rotacao). Gere: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEYS=
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
SENTRY_DSN=
WEB_CONCURRENCY=2
BACKUP_RETENTION_DAYS=14
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
